# Copy this file to .env and fill in real values for local development.

# Used by docker-compose.yml to create the Postgres container.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=templ_app
POSTGRES_PORT=5432

# Application roles created by db/init on first container start.
APP_DB_PASSWORD=change-me
MIGRATOR_DB_PASSWORD=change-me

# Used by goose (see Taskfile.yml db:migrate:* tasks).
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://postgres:postgres@localhost:5432/templ_app?sslmode=disable
GOOSE_MIGRATION_DIR=db/migrations
